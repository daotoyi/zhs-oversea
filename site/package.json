{
  "name": "zhenhesheng-com",
  "version": "0.0.18",
  "private": true,
  "description": "Zhen He Sheng — Dao Culture & Living. Overseas storefront for zhenhesheng.com",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "seed:products": "node scripts/sync-products.mjs",
    "deploy": "bash scripts/deploy.sh",
    "push": "bash scripts/push.sh",
    "push:status": "bash scripts/push.sh --status",
    "version:bump": "bash scripts/bump-version.sh",
    "version:push": "bash scripts/bump-version.sh --push"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "next": "^15.5.28",
    "opencc-js": "^1.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sql.js": "^1.15.1",
    "stripe": "17.5.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/sql.js": "^1.4.11",
    "typescript": "5.7.3"
  },
  "repository": {
    "type": "git",
