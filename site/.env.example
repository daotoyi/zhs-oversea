# ── 站点 ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zhenhesheng.com

# ── Stripe（香港主体，决策 1）─────────────────────────
# 账户国家/地区：Hong Kong
# 结算币种：USD
# 详见 .env.example 的完整说明
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Stripe Managed Payments（MoR，数字产品，决策 3）────
# 需单独申请资格，通过后启用；未开通前留空
STRIPE_MANAGED_PAYMENTS_ENABLED=false

# ── 结汇 / 收款 ─────────────────────────────────────
# Airwallex（多币种账户 + 广告虚拟卡）
AIRWALLEX_API_KEY=
# 万里汇 WorldFirst（结汇回大陆，0.3% 封顶、0 汇损）
WORLDFIRST_MERCHANT_ID=

# ── 邮件（弃购挽回 / 订单通知）───────────────────────
RESEND_API_KEY=
EMAIL_FROM=Zhen He Sheng <orders@zhenhesheng.com>

# ── 会员账户（前台注册登录 / 订单 / 积分 / 收藏）──────
# 会话签名密钥。留空则由 ADMIN_JWT_SECRET 派生（与后台不共用），
# 生产建议独立设置为一段 32+ 位随机串：openssl rand -hex 32
USER_JWT_SECRET=

# Google 登录（留空则该按钮不显示）
# 授权回调：https://zhenhesheng.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple 登录（留空则该按钮不显示）
# 授权回调：https://zhenhesheng.com/api/auth/oauth/apple/callback
# APPLE_PRIVATE_KEY 为 .p8 文件内容（含 BEGIN/END PRIVATE KEY），
# 可在 .env 中写成一行并用 \n 表示换行
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# 忘记密码邮件走上面 TENCENT_SES_* 通道；未配置时该功能会明确报错而不是假装已发送
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM=hello@zhenhesheng.com

# ── 分析 ────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
