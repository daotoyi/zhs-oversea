# ── 站点 ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zhenhesheng.com

# ── Stripe（香港主体，决策 1）─────────────────────────
# 账户国家/地区：Hong Kong
# 结算币种：USD
# 详见 .env.example 的完整说明
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Stripe Managed Payments（MoR，数字产品，决策 3）────
# 需单独申请资格，通过后启用；未开通前留空
STRIPE_MANAGED_PAYMENTS_ENABLED=false

# ── 结汇 / 收款 ─────────────────────────────────────
# Airwallex（多币种账户 + 广告虚拟卡）
AIRWALLEX_API_KEY=
# 万里汇 WorldFirst（结汇回大陆，0.3% 封顶、0 汇损）
WORLDFIRST_MERCHANT_ID=

# ── 邮件（弃购挽回 / 订单通知）───────────────────────
RESEND_API_KEY=
EMAIL_FROM=Zhen He Sheng <orders@zhenhesheng.com>

# ── 分析 ────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
