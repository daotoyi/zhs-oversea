# ── 站点 ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zhenhesheng.com

# ── Stripe（香港主体，决策 1）─────────────────────────
# 账户国家/地区：Hong Kong
# 结算币种：USD
# 详见 .env.example 的完整说明
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Stripe Managed Payments（MoR，数字产品，决策 3）────
# 需单独申请资格，通过后启用；未开通前留空
STRIPE_MANAGED_PAYMENTS_ENABLED=false

# ── PayPal（个人号可收，先 sandbox 后 live）────────────
# PAYPAL_ENV: sandbox（测试，用沙盒买家账号）或 live（真实收款）
# 个人号即可，无需香港主体；测试期用 sandbox 不花真钱
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ── 结汇 / 收款 ─────────────────────────────────────
# Airwallex（多币种账户 + 广告虚拟卡）
AIRWALLEX_API_KEY=
# 万里汇 WorldFirst（结汇回大陆，0.3% 封顶、0 汇损）
WORLDFIRST_MERCHANT_ID=

# ── 邮件 ────────────────────────────────────────────
# 推荐直接在后台 /admin/settings「邮件」填（存 settings 表，填完即生效、无需重启）。
# 数据库里的值优先于这里的环境变量。
#
# 三条管道分开走：
#   营销 → news.zhenhesheng.com（声誉独立，带退订链接与物理地址）
#   交易 → zhenhesheng.com（密码重置等，必须进收件箱）
#   收信 → 腾讯企业邮 MX（与上面无关）
#
# 完整 DNS 配置步骤见 docs/邮件配置清单.md
RESEND_API_KEY=
MAIL_FROM_TRANSACTIONAL=Zhen He Sheng <orders@zhenhesheng.com>
MAIL_FROM_MARKETING=Zhen He Sheng <news@news.zhenhesheng.com>
MAIL_REPLY_TO=hello@zhenhesheng.com
MAIL_PHYSICAL_ADDRESS=Zhen He Sheng Limited · Hong Kong SAR, China
MAIL_COMPANY_NAME=Zhen He Sheng
# 群发节流（Resend 免费档 2 req/s）
MAIL_THROTTLE_MS=600

# ── 会员账户（前台注册登录 / 订单 / 积分 / 收藏）──────
# 会话签名密钥。留空则由 ADMIN_JWT_SECRET 派生（与后台不共用），
# 生产建议独立设置为一段 32+ 位随机串：openssl rand -hex 32
USER_JWT_SECRET=

# ── 第三方登录（Google / Apple）────────────────────────
# 推荐直接在后台上传：/admin/settings「登录配置」页（存 settings 表，填完即生效、无需重启）。
# 数据库里的值优先于这里的环境变量；两者都没有时前台按钮显示「未开通」。
#
# Google：授权回调 https://zhenhesheng.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Apple：Return URL https://zhenhesheng.com/api/auth/oauth/apple/callback
# 注意用 Services ID（不是 App ID）；APPLE_PRIVATE_KEY 为 .p8 全文，
# 在 .env 中写成一行、用 \n 表示换行（后台页面粘贴则可直接多行）
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# 忘记密码等交易邮件走上面的 Resend 通道（v0.0.10 起已弃用腾讯云 SES：
# 跨境 + 共享 IP 撑不起「必须进收件箱」的邮件，且无法带 List-Unsubscribe 头）

# ── 分析 ────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
